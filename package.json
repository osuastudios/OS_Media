{
  "name": "os-media",
  "productName": "OS Media",
  "version": "1.0.2",
  "private": true,
  "description": "Descargador interno de vídeo/audio de YouTube y Twitch",
  "author": "OSUA Studio",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"vite\" \"npm:electron:dev\"",
    "electron:dev": "wait-on tcp:5173 && node electron/launch-dev.js",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.osuastudio.osmedia",
    "productName": "OS Media",
    "directories": {
      "output": "release"
    },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "icon": "build/icon.png",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    }
  }
}
